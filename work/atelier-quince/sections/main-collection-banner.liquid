{%- style -%}
	#MainContent {  padding: 0 0 5rem }
    
    .top_image {width:100%; padding-bottom:5rem}
    .top_image img {max-width:100%; width:100%}

    .shop-wrap { margin-top:0; }
    .shop-title { padding:10px 0 60px; }
    .shop-title p { width:230px; }

    .shop-category ul li { font-size:13px; margin:0 20px 0 0; }        
    .shop-categories { position:fixed; left:0; top:180px; padding:0 30px; }
    .shop-categories ul { margin:0px 0;  font-size:11px; text-transform:uppercase; }
    .shop-categories ul > li { padding:2px 0; }        
    .shop-categories ul > li > a:hover { font-weight:500; text-decoration:underline; color:#000; }
    
    .prd_cate_box { margin-bottom: 1rem;}
    .menuCategory { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem;}
    .menuCategory > li { font-family: 'Pretendard', 'UNO', sans-serif;  display: flex;  align-items: center;  font-size: 1rem;  line-height: 1.3; border: 1px solid #a39264;  border-radius: 10rem;  cursor: pointer; overflow:hidden;}
    .menuCategory > li > a { padding: 0.5rem 1.25rem; color:#a39264;}
    .menuCategory > li:hover a {background:#a39264; color:#fff;}
    
    .menu_category { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; display:none;}
    .menu_category > li { font-family: 'Pretendard', 'UNO', sans-serif;  display: flex;  align-items: center; font-size: 0.938rem;  line-height: 1.3; color: #000; cursor:pointer}
    .menu_category > li.active {font-weight:700;}
    .menu_category > li::after {content:''; width:1px; height:0.625rem; background:#000; margin-left:1rem; display:inline-block;}
    .menu_category > li:last-child::after {display:none}

	@media only screen and (device-width: 780px),
	only screen and (max-width: 780px),
	screen and (max-device-width: 780px) {
		#contents {  padding: 5.625rem 0 5rem }

		.shop-wrap { padding-left:0; margin:0; }
		.shop-categories { display:none; }
		
		.menuCategory.pc_view {display:none;}                
		.menu_category.pc_view {display:none;}        
		
		.prd_top_cate { margin-bottom: 0.625rem;}            
		.prd_cate_swiper  {width: calc(100% + 8%); margin: 0 -4%; padding: 0 4%; margin-bottom: 0.625rem;}
		.prd_cate_swiper .menuCategory {flex-wrap:nowrap; gap:0}
		.prd_cate_swiper .menuCategory > li {width:auto;}

		.top_image {padding-bottom:3rem}
	}

{%- endstyle -%}

<div class="top_image">
  <p class="banner">
    {% comment %} PC와 모바일 메타필드 구분하여 출력 {% endcomment %}
    {%- if collection.metafields.custom.top_banner_pc != blank or collection.metafields.custom.top_banner_mob != blank -%}

      {% comment %} PC 이미지 {% endcomment %}
      {%- if collection.metafields.custom.top_banner_pc != blank -%}
        <img src="{{ collection.metafields.custom.top_banner_pc | image_url: width: 1920 }}"  alt="{{ collection.title | escape }}"  class="pc_view">
      {%- endif -%}
	{%- endif -%}
      
      {% comment %} 모바일 이미지 {% endcomment %}
      {%- if collection.metafields.custom.top_banner_mob != blank -%}
        <img src="{{ collection.metafields.custom.top_banner_mob | image_url: width: 750 }}"  alt="{{ collection.title | escape }}"  class="mob_view">
      {%- endif -%}

  </p>
</div>