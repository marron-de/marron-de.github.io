<div class="home-instagrambox ver2">
    <div class="home-inner">
        <p class="home-title">Instagram</p>
        
        {% assign sorted_banners = shop.metaobjects.main_instagram.values | sort: 'banner_order'| reverse %}		
        <div class="swiperobx">    
			<div class="swiper home-instagrams">    
				<div class="swiper-wrapper">   
                {% for item in sorted_banners %}  
					{% if item.banner_img != blank %}    
					<div class="swiper-slide instagram-box">   
						<div class="contbox">
							<div class="imgbox">
								<a href="{{ item.banner_link }}" 
									target="{% if item.banner_link_target == true %}_blank{% else %}_self{% endif %}" 
									class="link">
									<img src="{{ item.banner_img | image_url: width: 600 }}" alt="{{ item.banner_title }}">
								</a>
							</div>
						</div>
					</div> 
                	{% endif %}
                {% endfor %}
				</div> 
			</div> 
            <div class="main-instagram-controls"> 
                <div class="swiper-button-prev"><i class="ph-thin ph-caret-left"></i></div>  
                <div class="swiper-button-next"><i class="ph-thin ph-caret-right"></i></div>           
            </div>  
		</div> 
    </div>
</div>