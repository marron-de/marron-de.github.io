{% assign related_products = product.metafields.custom.related.value %}
{% if related_products != blank %}
<div class="row conbox product-related">
	<h4 class="colpadding2 FBP">Recommended</h4>
	<ul class="thumbnail">
		{% for product in related_products %}
			<li class="col col33">{% render 'product-card-item', product: product %}</li>
		{% endfor %}
	</ul>
</div>
{% endif %}