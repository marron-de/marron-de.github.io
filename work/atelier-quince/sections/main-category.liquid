<div class="home-swiperbox home-shopbox ver2">
    <div class="home-inner">
        <p class="home-title">Shop by Category</p>
        
        {% comment %} 메타객체 타입: main_category 호출 {% endcomment %}
        {% assign sorted_banners = shop.metaobjects.main_category.values | sort: 'banner_order' | reverse %}

        <div class="swiper home-swiper main-shop">
            <div class="swiper-wrapper home-visual">
                {% for item in sorted_banners %}
					{% if item.banner_img != blank %}
					<a href="{{ item.banner_link }}" 
					target="{% if item.banner_link_target == true %}_blank{% else %}_self{% endif %}" 
					class="swiper-slide swiper-box">
						<div class="imgbox">
							{% comment %} 메타객체 이미지 필드: banner_img {% endcomment %}
							<img src="{{ item.banner_img | image_url: width: 600 }}" alt="{{ item.banner_title }}">
						</div>
						<div class="txtbox">
							<p class="txt GM">{{ item.banner_title }}</p>
						</div>
					</a>
					{% endif %}
                {% endfor %}
            </div>
            <div class="swiper-scrollbar home-scrollbar main-shop-scrollbar"></div>  
        </div>
    </div>
</div>