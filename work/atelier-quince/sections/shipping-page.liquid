

{%- style -%}

	#MainContent {padding: 5rem;}
    
    .care-wrap { padding-left:25%; position:relative; }
    .care-wrap .page-title { position: absolute; left: 0; top: 0; padding: 0; font-size: 1.75rem;}
    
    .care-wrap .care-contents h3 { font-size:1.2rem; text-transform:uppercase; }
    .care-wrap .care-contents p { margin: 1rem 0 5rem; font-size: 0.938rem; line-height: 1.6; max-width: 680px;}


    @media only screen and (device-width: 780px), only screen and (max-width: 780px),screen and (max-device-width: 780px) {

		#MainContent { padding: 90px 20px 0;}
            
        .care-wrap { padding-left:0%; position:relative; }
        .care-wrap .page-title { position:relative; left:0; top:0; text-transform:; padding:0; font-size:1.125rem; margin:0 0 1.875rem; }

    }    
 
{%- endstyle -%}

<div class="section">
    {{ page.content }}
</div>