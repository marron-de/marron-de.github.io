

{%- style -%}

	#MainContent {padding: 5rem;}
 
    .fr-view, .fr-view * { font-size: 15px !important;  line-height: 1.5 !important;  font-family:'GTS',serif!important;}
    
    .care-wrap { padding-left:25%; position:relative; }
    .care-wrap .page-title { position:absolute; left:0; top:0; text-transform:; padding:0; font-size:22px; }
	.care-wrap .care-contents {display: flex; flex-direction: column; gap: 24px; }
    .care-wrap .care-contents .fr-view { font-size:15px; line-height:1.5; max-width:680px; font-family:'GTS',serif;}
	.care-wrap .care-contents .fr-view a {color: #1155cc; text-decoration: underline;}
	.care-wrap .care-contents .fr-view .tit {font-weight: 700;}

	@media only screen and (device-width: 780px),
	only screen and (max-width: 780px),
	screen and (max-device-width: 780px) {

		#MainContent { padding: 50px 20px 0;}

		.care-wrap { padding-left:0%; position:relative; }
		.care-wrap .page-title { position:relative; left:0; top:0; text-transform:; padding:0; font-size:18px; margin:0 0 30px; }

    }
 
{%- endstyle -%}

<div class="section">
    {{ page.content }}
</div>