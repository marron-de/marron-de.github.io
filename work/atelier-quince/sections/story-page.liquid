

{%- style -%}
    .story { position: relative; }

    .story-1 {  position: relative;  width: 100%;  padding-top: 3rem; margin-bottom: 7rem;}
    .story-1 .txtbox { width:100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.938rem;}
    .story-1 .txtbox .txt1 { font-size: 3.25rem; color: #000000; letter-spacing: 0.04em;}
    .story-1 .txtbox .txt2 { font-family: 'Pretendard','UNO',sans-serif; font-size: 1.25rem; line-height: 1.6; color: #333333;}

    .story-2 {  position: relative;  width: 100%; height:100vh;  }
    .story-2 .bgbox { position: relative; width: 100%; height: 100%; overflow: hidden;}
    .story-2 .bgbox .bg { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 100%; height: 100%;}
    .story-2 .bgbox .bg > img { width: 100%; height: 100%; object-fit: cover;}
	
    .story-3 {  position: relative;  width: 100%; padding:10rem 0  }
    .story-3 .txtbox { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rem; width: 65%; margin-left: 30%; }
    .story-3 .txtbox .txt { color: #000000; letter-spacing: -0.02em;    max-width: 1080px;}
    .story-3 .txtbox .txt.kr { font-family: 'Pretendard','UNO',sans-serif; font-size: 1.2rem;  line-height: 1.8; color: #333333;  word-break: keep-all;}
    .story-3 .txtbox .txt.en { font-size: 1.4rem; line-height: 1.6; letter-spacing:0.03em}
    .story-3 .svg-circle { width: 43vw;  position: absolute; left: -12vw; top: 34vw; opacity: 0.66;}
    .story-3 .svg-circle .svg-container { height: 0; padding-top: 96%; position: relative;}
    .story-3 .svg-circle .circle-2 { position: absolute; left: 0; top: 0; width: 100%;}
    .story-3 .svg-circle .svg { position: absolute; top: 0; left: 0; height: 100%; width: 100%;}
	.st0 { fill: none; stroke: #000000; stroke-width: 0.2; stroke-miterlimit: 10;}
	
    .story-4 { position: relative;  width: 100%;}
    .story_keyword_cont { padding: 80px;  max-width: 1400px;  margin: auto; display: flex; align-items: center; gap: 10%;}
    .story_keyword_cont.reverse {}
    .story_keyword_cont .left { width: 50%; }
    .story_keyword_cont .right { width: 50%;}
    .story_keyword_cont .imgbox { position: relative; aspect-ratio: 1/1.25;}
    .story_keyword_cont .imgbox .bgbox { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 100%; height: 100%;}
    .story_keyword_cont .imgbox .bgbox .bg { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 100%; height: 100%; display: flex;}
    .story_keyword_cont .imgbox .bgbox .bg > img { width: 100%; height: 100%; object-fit: cover;}
    .story_keyword_cont .txtbox { position: relative; flex: 1; text-align: left;}
    .story_keyword_cont .txtbox .title { font-size: 5rem; color: #000000; letter-spacing: -0.02em; margin-bottom: 2rem;}
    .story_keyword_cont .txtbox .desc { font-size: 1.2rem; line-height: 2; color: #333333;}
    .story_keyword_cont .txtbox .desc .en {display:block;}

    .story-5 { position: relative; margin: 7rem 0 5rem;}
    .story-5 .txtbox { width: 90%; max-width: 1200px; margin: 0 auto 12rem; text-align: left;}
    .story-5 .txtbox .desc { font-size: 1.35rem; line-height: 1.8; color: #000000; word-break: keep-all;}
    .story-5 .imgbox .bgbox { position: relative; width: 100%; height:70vh}
    .story-5 .imgbox .bgbox .bg {position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 100%; height: 100%; display: flex;}
    .story-5 .imgbox .bgbox .bg > img {width: 100%; height: 100%; object-fit: cover;}

    @media only screen and (device-width: 780px),  
	only screen and (max-width: 780px), screen and (max-device-width: 780px) {   

		#MainContent { margin: 0;}    

        .story-1 { padding-top: 5rem; margin-bottom: 6rem;}
        .story-1 .txtbox { gap: 0.5rem; width: 90%; margin: auto; text-align: center;}
        .story-1 .txtbox .txt1 { font-size: 2.5rem;}
        .story-1 .txtbox .txt2 { font-size: 1rem;}        

        .story-2 { height: 70vh;}

        .story-3 { padding: 7rem 0;}
        .story-3 .txtbox { gap: 5rem;  width: 90%; margin: 0 auto; text-align: center;}
        .story-3 .txtbox .txt.kr {  font-size: 1rem;}
        .story-3 .txtbox .txt.en { font-size: 1.2rem;}
        .story-3 .svg-circle {  display: none;}

        .story_keyword_cont { padding: 0; width: 90%; flex-direction: column; gap: 2rem}
        .story_keyword_cont + .story_keyword_cont { margin-top: 6rem;}
        .story_keyword_cont.reverse { flex-direction: column-reverse;}
        .story_keyword_cont .left { width: 100%;}
        .story_keyword_cont .right { width: 100%;}
        .story_keyword_cont .txtbox .title { font-size: 2.5rem; margin-bottom: 1rem; margin-top:0}
        .story_keyword_cont .txtbox .desc { font-size: 1rem; line-height: 1.7;}
        .story_keyword_cont .txtbox .desc br { display: none;}        

        .story-5 {  margin: 7rem 0 0rem;}
        .story-5 .txtbox { margin: 0 auto 7rem;}
        .story-5 .txtbox .desc { font-size: 1.15rem;}  
    }

{%- endstyle -%}

<div class="story">
    {{ page.content }}
</div>
