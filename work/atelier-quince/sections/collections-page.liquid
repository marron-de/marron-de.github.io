

{%- style -%}
	#MainContent { margin-left: auto; margin-right:auto;  padding: 5rem;}
	.cate-collections > a { text-decoration:unset; font-weight: bold; color:#1C3327; }
	.collection-wrap {margin-top:-80px;}
	.collection-list { text-align:center; margin:0 -80px; }
	.collection-list .collection-item { width:54%; vertical-align:middle; }

	.collection-list .collection-item .collection-item-inner { display:inline-block; margin:0 auto; }
	.collection-list .collection-item .collection-info { text-align:center; margin:30px auto; }
	.collection-list .collection-item .collection-info p.collection-no { margin-bottom:6px; font-size:12px; color:#000; font-family: 'UNO', Noto Sans KR, sans-serif;}
	.collection-list .collection-item .collection-info p.collection-title a { font-size:22px; color: #555555; }
	
	.collection-list .collection-item .collection-image { text-align:center; position:relative; font-size:0; }
	.collection-list .collection-item .collection-image > a { width: 310px; height: 50vh;}
	.collection-list .collection-item .collection-image img { height:100%; width:100%; object-fit: cover; transition: ease 0.5s;}
	
	.collection-list .collection-item .collection-image .circle { background:#1C3327; color:#FFF; width:80px; height:80px; border-radius:50%; position:absolute; bottom:-30px; left:50%; transform:translateX(-50%); }
	.collection-list .collection-item .collection-image .circle span { position:absolute; left:50%; top:50%; text-transform:uppercase; font-size:10px; text-align:center; transform:translate(-50%, -50%); }
	
	.collection-list .collection-item .collection-desc { max-width:460px; margin:45px auto; text-align:left; line-height:1.45; min-height:120px;  font-size:16px; letter-spacing: 0.06em; text-align: center;}
			
	.collection-wrap .flickity-prev-next-button { width:16%; height:100%; }
	.collection-wrap .flickity-prev-next-button svg { width:25px; left:50%; transform:translateX(-50%); opacity:0; }	
	
	.collection-list .collection-item .collection-item-inner:hover > .collection-image img { transform:scale(1.05); }
	
	@media only screen and (device-width: 780px),
		only screen and (max-width: 780px),
		screen and (max-device-width: 780px) {

		#MainContent { padding: 90px 20px 0; margin:0}

		.collection-list { text-align:center; margin:100px -20px 0; overflow:hidden}
		.collection-list .collection-item { width:100%; vertical-align:middle; padding:0 25px; }
		.collection-list .collection-item .collection-image > a { width: 90%; height: 65vh;}

	}

{%- endstyle -%}

<div class="collection">
    {{ page.content }}
</div>
