{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

{%- style -%}
     
    #MainContent { padding:5rem 5rem 0 }         
    
    .cart-wrap { max-width: 100%;}
    
    #NaverChk_Button .npay_storebtn_bx { width: 100% !important;}
    
	@media screen and (max-width:780px) {          
		#MainContent { margin: 4rem auto 0; padding: 90px 20px 0;}         
		#footer { margin-top: 0; }
	}

{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<cart-items class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
 <div class="page-wrap">
    <div class="cart_banner_box">
		{%- assign banners = shop.metaobjects.cart_top_banner.values | sort: 'banner_order' | reverse  -%}
		{%- if banners.size > 0 -%}
			{%- comment -%} PC 배너 {%- endcomment -%}
			<div class="swiper cart_banner pc_view">    
				<div class="swiper-wrapper">         
					{%- for banner in banners -%}
					{%- if banner.banner_img_pc != blank -%}
						<div class="swiper-slide">  
						<div class="imgbox">
							<a href="{{ banner.banner_link }}" {% if banner.banner_link_target %}target="_blank"{% endif %}>
								<img src="{{ banner.banner_img_pc | image_url: width: 1920 }}" alt="">
							</a>
						</div>
						</div>
					{%- endif -%}
					{%- endfor -%}
				</div>          
				<div class="swiper-pagination cart_banner_pag"></div>
			</div>   

			{%- comment -%} 모바일 배너 {%- endcomment -%}
			<div class="swiper mob_cart_banner mob_view">    
				<div class="swiper-wrapper">         
					{%- for banner in banners -%}
					{%- if banner.banner_img_mob != blank -%}
						<div class="swiper-slide">  
						<div class="imgbox">
							<a href="{{ banner.banner_link }}" {% if banner.banner_link_target %}target="_blank"{% endif %}>
								<img src="{{ banner.banner_img_mob | image_url: width: 800 }}" alt="">
							</a>
						</div>
						</div>
					{%- endif -%}
					{%- endfor -%}
				</div>          
				<div class="swiper-pagination mob_cart_banner_pag"></div>
			</div>
		{%- endif -%}
	</div>

	<div class="page_cont_wrap">
		<div class="section conbox cart-wrap">
            <div class="cart_contbox">
				<div class="leftbox">

                    <div class="gift_cont">
						<p class="gift_tit">Special Gift for You</p>
						<div class="swiper gift_banner">    
							<div class="swiper-wrapper">         
							{%- assign gifts = shop.metaobjects.cart_gift.values | sort: 'banner_order' -%}
							
							{%- for gift in gifts -%}
								{%- if gift.banner_img != blank -%}
								<div class="swiper-slide item" data-price="{{ gift.banner_gift_price }}">  
									<div class="imgbox">
										<div class="circle_box">
											<svg class="circle_svg" viewBox="22 22 44 44">
											<circle class="circle" cx="44" cy="44" r="21.25" fill="none" stroke-width="1.5"></circle>
											</svg>
										</div>
										<img src="{{ gift.banner_img | image_url: width: 400 }}" alt="{{ gift.banner_title | escape }}">
									</div>
									<div class="txtbox">
										<p class="tit">{{ gift.banner_title }}</p>
										<p class="desc">{{ gift.banner_desc | replace: '[price]', '<span class="price"></span>' }}</p>
									</div>
								</div>
								{%- endif -%}
							{%- endfor -%}
							</div>          
						</div>
					</div>
                               
                    <div class="cart_titbox">
                        <h3 class="page-title">Cart</h3>      
                        <p class="count">{{ cart.item_count }} items</p>
                    </div>

					{% comment %} <div class="title-wrapper-with-link">
						<h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
						<a href="{{ routes.all_products_collection_url }}" class="underlined-link">
							{{- 'general.continue_shopping' | t -}}
						</a>
					</div> {% endcomment %}

					<div class="cart__warnings xans-order-empty">
                        <p>Your cart is empty.</p>
                        <a href="{{ routes.all_products_collection_url }}" class="link">Continue shopping</a>
						{% comment %} <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
						<a href="{{ routes.all_products_collection_url }}" class="button">
							{{ 'general.continue_shopping' | t }}
						</a> {% endcomment %}
						{%- if shop.customer_accounts_enabled and customer == null -%}
							<h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
							<p class="cart__login-paragraph">
							{{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
							</p>
						{%- endif -%}
					</div>

					<form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
						<div class="cart__items cart-list" id="main-cart-items" data-id="{{ section.id }}">
							<div class="js-contents">
							{%- if cart != empty -%}
								<ul class="xans-order-list">
									{%- for item in cart.items -%}
									<li class=""
										id="CartItem-{{ item.index | plus: 1 }}"
										{% if item.parent_relationship.parent != null %}
										aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
										{% endif %}
									>
										<div class="imgbox">
										{% if item.image %}
											{% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
											<div class="cart-list-col cart-list-thumb">
												{% comment %} <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a> {% endcomment %}
												<img
													src="{{ item.image | image_url: width: 300 }}"
													class="cart-item__image thumb-img {% if item.parent_relationship.parent != null %}global-media-settings{% endif %}"
													alt="{{ item.image.alt | escape }}"
													loading="lazy"
													width="150"
													height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
												>
											</div>
										{% endif %}
										</div>

                                		<div class="txtbox">
											<div class="cart-list-col cart-list-product">
												<div class="cart-item__details">
													<div class="cart-list-name">
														{%- if settings.show_vendor -%}
															<p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
														{%- endif -%}

														<a href="{{ item.url }}" class="cart-item__name h4 break Pretendard">{{ item.product.title | escape }}</a>
													</div>

													{% comment %} {%- if item.original_price != item.final_price -%}
														<div class="cart-item__discounted-prices">
															<span class="visually-hidden">
																{{ 'products.product.price.regular_price' | t }}
															</span>
															<s class="cart-item__old-price product-option">
																{{- item.original_price | money -}}
															</s>
															<span class="visually-hidden">
																{{ 'products.product.price.sale_price' | t }}
															</span>
															<strong class="cart-item__final-price product-option">
																{{ item.final_price | money }}
															</strong>
														</div>
													{%- else -%}
														<div class="product-option">
														{{ item.original_price | money }}
														</div>
													{%- endif -%} {% endcomment %}

													{%- if item.product.has_only_default_variant == false
														or item.properties.size != 0
														or item.selling_plan_allocation != null
													-%}
														<dl class="cart-list-option Pretendard">
														{%- if item.product.has_only_default_variant == false -%}
															{%- for option in item.options_with_values -%}
															<div class="product-option">
																<dt>{{ option.name }}:</dt>
																<dd>{{ option.value }}</dd>
															</div>
															{%- endfor -%}
														{%- endif -%}

														{%- for property in item.properties -%}
															{%- assign property_first_char = property.first | slice: 0 -%}
															{%- if property.last != blank and property_first_char != '_' -%}
															<div class="product-option">
																<dt>{{ property.first }}:</dt>
																<dd>
																{%- if property.last contains '/uploads/' -%}
																	<a href="{{ property.last }}" class="link" target="_blank">
																	{{ property.last | split: '/' | last }}
																	</a>
																{%- else -%}
																	{{ property.last }}
																{%- endif -%}
																</dd>
															</div>
															{%- endif -%}
														{%- endfor -%}
														</dl>

														<p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
													{%- endif -%}

													{% comment %} <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
														{%- for discount in item.line_level_discount_allocations -%}
														<li class="discounts__discount">
															{{- 'icon-discount.svg' | inline_asset_content -}}
															{{ discount.discount_application.title | escape }}
														</li>
														{%- endfor -%}
													</ul> {% endcomment %}

													<div class="cart-item__totals right medium-hide large-up-hide">
														{%- render 'loading-spinner' -%}
														<div class="cart-item__price-wrapper">
														{%- if item.original_line_price != item.final_line_price -%}
														<dl class="cart-item__discounted-prices">
															<dt class="visually-hidden">
															{{ 'products.product.price.regular_price' | t }}
															</dt>
															<dd>
															<s class="cart-item__old-price price price--end">
																{{ item.original_line_price | money }}
															</s>
															</dd>
															<dt class="visually-hidden">
															{{ 'products.product.price.sale_price' | t }}
															</dt>
															<dd class="price price--end">
															{{ item.final_line_price | money }}
															</dd>
														</dl>
														{%- else -%}
														<span class="price price--end">
															{{ item.original_line_price | money }}
														</span>
														{%- endif -%}

														{%- if item.variant.available and item.unit_price_measurement -%}
														{% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
														{%- endif -%}
														</div>
													</div>												
												</div>

												{%- liquid
												assign has_qty_rules = false
												if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
													assign has_qty_rules = true
												endif

												assign has_vol_pricing = false
												if item.variant.quantity_price_breaks.size > 0
													assign has_vol_pricing = true
												endif
												-%}
												<div class="cart-list-quantity cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
													<quantity-popover>
														<div class="cart-item__quantity-wrapper quantity-popover-wrapper">
														<label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
															{{ 'products.product.quantity.label' | t }}
														</label>
														<div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
															{%- if has_qty_rules or has_vol_pricing -%}
															<button
																type="button"
																aria-expanded="false"
																class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
															>
																{{- 'icon-info.svg' | inline_asset_content -}}
															</button>
															{%- endif -%}
															<quantity-input class="cart-quantity">
															{% assign can_update_quantity = item.instructions.can_update_quantity | default: true %}
															<button
																class="quantity__button"
																name="minus"
																type="button"
																{% if can_update_quantity == false %}
																disabled
																{% endif %}
															>
																<span class="visually-hidden">
																{{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
																</span>
																<span class="svg-wrapper">
																{{- 'icon-minus.svg' | inline_asset_content -}}
																</span>
															</button>
															<input
																class="quantity__input"
																data-quantity-variant-id="{{ item.variant.id }}"
																type="number"
																name="updates[]"
																value="{{ item.quantity }}"
																{% # theme-check-disable %}
																data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
																min="0"
																data-min="{{ item.variant.quantity_rule.min }}"
																{% if item.variant.quantity_rule.max != null %}
																max="{{ item.variant.quantity_rule.max }}"
																{% endif %}
																step="{{ item.variant.quantity_rule.increment }}"
																{% # theme-check-enable %}
																aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
																id="Quantity-{{ item.index | plus: 1 }}"
																data-index="{{ item.index | plus: 1 }}"
																{% if can_update_quantity == false %}
																disabled
																{% endif %}
															>
															<button
																class="quantity__button"
																name="plus"
																type="button"
																{% if can_update_quantity == false %}
																disabled
																{% endif %}
															>
																<span class="visually-hidden">
																{{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
																</span>
																<span class="svg-wrapper">
																{{- 'icon-plus.svg' | inline_asset_content -}}
																</span>
															</button>
															</quantity-input>
														</div>
														</div>
														{%- if has_qty_rules or has_vol_pricing -%}
														<button
															type="button"
															class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
															aria-expanded="false"
														>
															{{- 'icon-info.svg' | inline_asset_content -}}
															<span>
															{%- if has_vol_pricing -%}
																{{ 'products.product.volume_pricing.note' | t }}
															{%- elsif has_qty_rules -%}
																{{ 'products.product.quantity.note' | t }}
															{%- endif -%}
															</span>
														</button>
														{%- endif -%}
														{%- if has_vol_pricing or has_qty_rules -%}
														<div
															class="cart-items__info global-settings-popup quantity-popover__info"
															tabindex="-1"
															hidden
														>
															{%- if has_qty_rules == false -%}
															<span class="volume-pricing-label caption">
																{{- 'products.product.volume_pricing.title' | t -}}
															</span>
															{%- endif -%}
															<div class="quantity__rules caption">
															{%- if item.variant.quantity_rule.increment > 1 -%}
																<span class="divider">
																{{-
																	'products.product.quantity.multiples_of'
																	| t: quantity: item.variant.quantity_rule.increment
																-}}
																</span>
															{%- endif -%}
															{%- if item.variant.quantity_rule.min > 1 -%}
																<span class="divider">
																{{-
																	'products.product.quantity.min_of'
																	| t: quantity: item.variant.quantity_rule.min
																-}}
																</span>
															{%- endif -%}
															{%- if item.variant.quantity_rule.max != null -%}
																<span class="divider">
																{{-
																	'products.product.quantity.max_of'
																	| t: quantity: item.variant.quantity_rule.max
																-}}
																</span>
															{%- endif -%}
															</div>
															<button
															class="button-close button button--tertiary large-up-hide"
															type="button"
															aria-label="{{ 'accessibility.close' | t }}"
															>
															<span class="svg-wrapper">
																{{- 'icon-close.svg' | inline_asset_content -}}
															</span>
															</button>
															{%- if item.variant.quantity_price_breaks.size > 0 -%}
															<volume-pricing class="parent-display">
																<ul class="list-unstyled">
																<li>
																	<span>{{ item.variant.quantity_rule.min }}+</span>
																	{%- assign price = item.variant.price | money_with_currency -%}
																	<span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
																</li>
																{%- for price_break in item.variant.quantity_price_breaks -%}
																	<li>
																	<span>
																		{{- price_break.minimum_quantity -}}
																		<span aria-hidden="true">+</span></span
																	>
																	{%- assign price = price_break.price | money_with_currency -%}
																	<span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
																	</li>
																{%- endfor -%}
																</ul>
															</volume-pricing>
															{%- endif -%}
														</div>
														{%- endif -%}
														<div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
														<small class="cart-item__error-text"></small>
														<span class="svg-wrapper">
															{{- 'icon-error.svg' | inline_asset_content -}}
														</span>
														</div>
													</quantity-popover>
												</div>

												<div class="cart-item__totals right cart-list-price Pretendard">
													{%- render 'loading-spinner' -%}
													<div class="cart-item__price-wrapper">
														{%- if item.original_line_price != item.final_line_price -%}
														<dl class="cart-item__discounted-prices">
															<dt class="visually-hidden">
															{{ 'products.product.price.regular_price' | t }}
															</dt>
															<dd>
															<s class="cart-item__old-price price price--end">
																{{ item.original_line_price | money }}
															</s>
															</dd>
															<dt class="visually-hidden">
															{{ 'products.product.price.sale_price' | t }}
															</dt>
															<dd class="price price--end">
															{{ item.final_line_price | money }}
															</dd>
														</dl>
														{%- else -%}
														<span class="price price--end">
															{{ item.original_line_price | money }}
														</span>
														{%- endif -%}

														{%- if item.variant.available and item.unit_price_measurement -%}
														{% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
														{%- endif -%}
													</div>
												<div>
											</div>
											
											<div class="cart-list-bottom">												
												<cart-remove-button id="Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}"
													{% assign can_remove = item.instructions.can_remove | default: true %}
													class="cart-list-remove {% if can_remove == false %} hidden {% endif %} "	>
													<a
													href="{{ item.url_to_remove }}"
													class="button button--tertiary"
													aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
													>
													{% comment %} <span class="svg-wrapper">
														{{- 'icon-remove.svg' | inline_asset_content -}}
													</span> {% endcomment %}
													<i class="xi-close"></i>
													</a>
												</cart-remove-button>
											</div> 
										<div>
									</li>
									{%- endfor -%}
								</ul>
							{%- endif -%}
							</div>
						</div>

						<p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
						<p
							class="visually-hidden"
							id="shopping-cart-line-item-status"
							aria-live="polite"
							aria-hidden="true"
							role="status"
						>
							{{ 'accessibility.loading' | t }}
						</p>
					</form>
				</div>

				<div class="rightbox cart-summary">
					<div class="cart-summarybox">
						<ul>
							<li>
								<label>Product Price</label>
								<span class="value">{{ cart.original_total_price | money }}</span>
							</li>
							<li>
								<label>Delivery Price</label>
								<span class="value">At Checkout</span>
							</li>                            
							<li class="{% if cart.total_discounts == 0 %}hidden{% endif %}">              
								<label>Discount Price</label>                                             
								<span class="value">-{{ cart.total_discounts | money }}</span>
							</li>
							<li class="last">
								<label><b>Total Amount</b></label>
								<span class="value">
									<b id="total_price" data-price="{{ cart.total_price }}">
										{{ cart.total_price | money_with_currency }}
									</b>
								</span>
							</li>
						</ul>  
						<div class="cart-button page-button">  
							<button type="submit" id="checkout" class="cart__checkout-button button checkout" name="checkout" 
								{% if cart == empty %}  disabled {% endif %}  form="cart">ORDER</button>    
							<a href="{{ routes.all_products_collection_url }}" class="button" style="margin-top: 1rem;" >CONTINUE SHOPPING</a>
						</div>                 
					</div>
				</div>
  			</div>
		</div>
  	</div>
  </div>
</cart-items>

<div class="cart-recommend">
  <div class="inner">
    <p class="recommend_title">Recommended Products</p>
    
    <div class="swiper cart_recommendswiper ec-base-product">
      <div class="swiper-wrapper thumbnail ver2">
        {%- assign recommended_products = shop.metaobjects.cart_recommended.values | sort: 'product_order' | reverse -%}
        
        {%- for item in recommended_products -%}
          {%- assign product = item.product_ref.value -%}
          {%- if product != blank -%}
            <div class="swiper-slide swiper-box col col33">           
              <div class="thumbnail-image">
                <a href="{{ product.url }}" class="noborder">
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="thumb-img"/>
                </a>
              </div>
              
              <div class="thumbnail-info">
                <p class="name Pretendard">
                  <a href="{{ product.url }}">{{ item.product_name | default: product.title }}</a>
                </p>                                     
                
                <div class="price Pretendard">
                  {%- if product.compare_at_price > product.price -%}
                    <div class="Pretendard top_price">
                      <span style="text-decoration:line-through; display:inline-block; opacity:0.35; margin-right:5px;" class="sale_price">
                        {{ product.compare_at_price | money }}
                      </span>
                      <span class="discount pro_rate">
                        {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%
                      </span> 
                    </div>
                  {%- endif -%}
                  
                  <div class="current_price">
                    {{ product.price | money }}
                  </div>
                </div>         

                {%- unless product.available -%}
                  <div class="soldout Pretendard">Sold Out</div>
                {%- endunless -%}
              </div>   
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div> 
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
