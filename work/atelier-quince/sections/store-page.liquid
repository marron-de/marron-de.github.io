

{%- style -%}
	#MainContent {padding: 5rem 0;}    

    .mobiledp {display:none;}
    .pcdp {display:block;}

    .store-titbox {  margin-bottom: 0.938rem; padding: 0 2.5rem;}
    .store-titbox .title {font-size: 1.875rem; margin:0; font-family: 'UNO', Noto Sans KR, sans-serif;}

    .store-list-wrap .store-list { padding: 0.938rem 2.5rem 1.5rem; display: flex; align-items: center; gap: 3.75rem;;}
    .store-list-wrap .store-list li { font-family: 'Pretendard','UNO',sans-serif;font-size: 1.125rem}
    .store-list-wrap .store-list li a {font:inherit; color:inherit;}
    .store-list-wrap .store-list li.on a { text-decoration: underline; text-underline-offset: 5px;}

    .store-list-wrap .store-second-depth { display: flex; align-items: center;  gap: 1rem; padding: 0.625rem 2.5rem 1.875rem;}
    .store-list-wrap .store-second-depth li.on { background: #000; color: #F8F7EF;}
    .store-list-wrap .store-second-depth li { font-family: 'Pretendard','UNO',sans-serif; display: inline-flex; align-items: center; justify-content: center;  height: 1.875rem;  line-height: 1;  padding: 0 0.875rem;
        border: 1px solid #000;  border-radius: 0.313rem;  font-size: 1rem; }
    .store-list-wrap .store-second-depth li a {font:inherit; color:inherit; transition:none;}

    .store-content {position:relative; margin-top:0.938rem}
    .store-tab-list { position: relative; display: flex; flex-direction: column;min-height: 50vw;}
    .store-tab {  width: 100%; }
    .store-tab .store-info {font-family: 'Pretendard', 'UNO', sans-serif; width: 50%; border-bottom: 1px solid #e6e6e6; color: #000; padding: 1.25rem 5rem 1.25rem 2.5rem; display: flex; gap: 2rem; cursor:pointer; transition: all 0.25s ease}
    .store-tab .store-info:hover { background: rgba(252, 250, 246, 0.5);}
    .store-tab .store-info-item { display: flex; flex-direction: column; gap: 2rem;}
    .store-tab .store-info-item.kr {width:30%}
    .store-tab .store-info-item.en {flex:1;}
    .store-tab .store-info-item .tit { font-size: 1rem;  font-weight: 500; }
    .store-tab .store-info-item .desc { font-size: 0.875rem; line-height: 1.6;}
    .store-tab .store-info .icon { margin-left: auto; font-size: 1.875rem;}
    .store-tab .store-info .icon .ph-fill{display:none;}
    .store-tab .store-map { position: absolute; top: 0; right: 0;  width: 50%; display:none; z-index:10}
    .store-tab .store-map iframe {  width: 100% !important;  height: unset;  aspect-ratio: 1 / 1}

    .store-tab .store-linkbox { width: 50%; display: flex; flex-direction: column;}
    .store-tab .store-linkbox .store-info { width: 100%; min-height: calc(50vw / 8 - 1px);}
    .store-tab .store-slider {position: absolute; top: 0; right: 0;  width: 50%; display:none; z-index:10}
    .store-tab .store-slider .location-slider { width: 100%;}
    .store-tab .store-slider .location-slider .swiper-slide { width: 100%;}
    .store-tab .store-slider .location-slider .swiper-slide img { width: 100%; aspect-ratio: 1/1; object-fit: cover;}  

    .store-tab.on .store-info .icon .ph {display:none}
    .store-tab.on .store-info .icon .ph-fill{display:block}
    .store-tab.on .store-map {display:block}
    
    .store-wrap.type-1 .store-tab[data-num="type-2"] { display: none;}
    .store-wrap.type-2 .store-tab[data-num="type-1"] { display: none;}
    .store-wrap.type-1.depth-2 .store-tab[data-depth="depth-3"] { display: none;}   
    .store-wrap.type-1.depth-3 .store-tab[data-depth="depth-2"] { display: none;}  
    .store-wrap.type-2 .store-second-depth { display: none;}    
    .store-wrap.type-2 .store-slider { display: block;}



    @media screen and (max-width: 1440px) {    
        
        .store-tab .store-info { padding: 1.25rem 3rem 1.25rem 2.5rem;  gap: 1rem}
        .store-tab .store-info-item .desc br.br1440 {display:none;}

    }


    @media screen and (max-width: 1024px) {    
        .mobiledp {display:block;}
        .pcdp {display:none;}     

        .store-titbox { padding: 0 20px; margin-bottom: 20px; margin-top: 45px;}
        .store-titbox .title { font-size: 26px;}
        .store-list-wrap .store-list { padding: 0 20px; gap: 30px;}
        .store-list-wrap .store-list li { font-size: 14px;}
        .store-list-wrap .store-second-depth { padding: 14px 20px 10px; gap: 16px;}
        .store-list-wrap .store-second-depth li {  height: 25px;  padding: 0 14px;  border-radius: 5px;  font-size: 14px;}

        .store-tab-list { min-height: unset; padding-top: 100%;}
        .store-tab .store-info {  position: relative;  width: 100%; flex-direction: column; padding: 20px;}
        .store-tab .store-info-item { gap: 20px;}
        .store-tab .store-info-item.kr { width: 100%;}
        .store-tab .store-info-item .tit { font-size: 0.95rem;}
        .store-tab .store-info-item .desc br.br1440 {display:block;}
        .store-tab .store-info .icon { position: absolute; top: 20px; right: 20px; font-size: 25px;}
        .store-tab .store-map { width: 100%;}

        .store-tab .store-linkbox { width: 100%;}
        .store-tab .store-linkbox .store-info { width: 100%; height: unset;}
        .store-wrap.type-2 .store-slider { width: 100%;}
    }
	

	@media only screen and (device-width: 780px),
		only screen and (max-width: 780px),
		screen and (max-device-width: 780px) {

		#MainContent { padding: 0 0 5rem;}
		
	}
 
{%- endstyle -%}

<div class="section">
    {{ page.content }}
</div>
