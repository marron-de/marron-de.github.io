<div class="home-collectionbanner">      
    {% assign sorted_banners = shop.metaobjects.main_collection.values %}
    <div class="home-inner">
        <p class="home-title">Collection</p>
		{% for item in sorted_banners %}
			{% if item.banner_img_pc != blank %}
			<div class="contbox">   
				<div class="imgbox">
					<img src="{{ item.banner_img_pc | image_url: width: 1920 }}" alt="{{ item.bannertitle | escape }}" class="pc_view">
					<img src="{{ item.banner_img_mob | image_url: width: 1920 }}" alt="{{ item.bannertitle | escape }}" class="mob_view">
				</div>
				<div class="txtbox">
					<p class="desc">
						{{ item.banner_title }}
						<span class="fw300">—</span>
						<br class="mob_view">
						{{ item.banner_desc }}					
					</p>
					<a class="link" href="{{ item.banner_link | default: '#' }}" 
						target="{% if item.banner_link_target == true %}_blank{% else %}_self{% endif %}">
						{{ item.banner_link_title }}
					</a>           
				</div>
			</div> 
			{% endif %}
		{% endfor %}
    </div>   
</div> 