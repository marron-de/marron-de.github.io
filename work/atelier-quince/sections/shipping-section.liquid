{% assign active_content = shop.metaobjects.shipping_content.values | sort: 'term_order' %}

 <div class="section care-wrap">
        <h3 class="page-title serif">Shipping &amp; Returns</h3>
        
        <div class="row care-contents">
            <div class="col sans">
        		{% for item in active_content %}                
                <h3 class="serif">{{ item.term_title }}</h3>
                <p class="ko serif">
					{{ item.term_desc }}               
                </p>
       			 {% endfor %}
            </div>
        </div>
        
    </div>
