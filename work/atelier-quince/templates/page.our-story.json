        "heading": {
          "type": "heading",
          "settings": {
            "title": "Fabrication & Sustainability",
            "heading_tag": "h2",
            "heading_font_class": "fs-heading-2-base"
          }
        },
        "spacer-2": {
          "type": "spacer",
          "settings": {
            "space": 20
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>We're committed to making cherished pieces that sustain a long lifetime in a women’s wardrobe. We firmly believe in our responsibility to minimise our impact on the planet & strive towards promoting sustainability.<br/><br/>To achieve this, we are dedicated to constantly innovating, evolving & adopting new sustainable practices in every aspect of our business. By remaining dynamic & constantly evolving, we endeavour to reduce our impact & foster a healthier, more sustainable future.</p>",
            "text_font_class": "fs-body-100"
          }
        }
