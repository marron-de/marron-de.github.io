<div class="section conbox board-wrap">
    <h3 class="board_title">NOTICE</h3>
    {% assign notices = shop.metaobjects.notice_content.values | sort: 'notice_order' | reverse %}
	<div class="board_tblwrap">
		<div class="board_tblbox">
			<table class="board_tbl">
				<colgroup>
					<col style="width: 85%;">
					<col style="width: 15%;">
				</colgroup>
				<thead>
					<tr>
						<th class="Pretendard">Title</th>
						<th class="Pretendard">Writer</th>
					</tr>
				</thead>
				<tbody>
					{% for notice in notices %}
					<tr class="xans-record-">
						<td class="title_td Pretendard">{{ notice.notice_title }}</td>
						<td class="Pretendard">Atelier Quince</td>
					</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</div>
</div>