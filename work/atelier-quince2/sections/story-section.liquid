{% assign sorted_banners = shop.metaobjects.story_content.values %}
{% assign first_item = sorted_banners | first %}

{% if first_item != blank %}

<div class="story-1">
    <div class="txtbox">
        <p class="txt1 FBP">
            “Artful Journey with <br class="mob_view">
            Atelier Quince”
        </p>
    </div>
</div>

<div class="story-2"> 
    <div class="bgbox">
        <div class="bg">
            {% if first_item.section1_img != blank %}
                <img src="{{ first_item.section1_img | image_url: width: 1920 }}" alt="Atelier Quince">
            {% endif %}
        </div>
    </div>      
</div>

<div class="story-3">        
    <div class="txtbox">  
        <p class="txt en serif pc_view">{{ first_item.section1_content_pc }}</p>
        <p class="txt en serif mob_view">{{ first_item.section1_content_mob }}</p>
    </div>
    <div class="svg-circle" data-scroll-speed="4">           
        <div class="circle-1">
            <div class="svg-container">{{ 'circle-1.svg' | asset_url | img_tag: 'circle', 'svg' }}</div>
        </div>              
        <div class="circle-2">        
            <div class="svg-container">{{ 'circle-2.svg' | asset_url | img_tag: 'circle', 'svg' }}</div>
        </div>          
    </div>  
</div>

<div class="story-4 story_keyword_cont">    
    <div class="left imgbox">
        <div class="bgbox"><div class="bg"><img src="{{ first_item.section2_banner1_img | image_url: width: 800 }}" alt="{{ first_item.section2_banner1_title }}"></div></div>
    </div>      
    <div class="right txtbox">                
        <p class="title serif">{{ first_item.section2_banner1_title }}</p>                
        <p class="desc serif">{{ first_item.section2_banner1_dsec }}</p>
    </div>
</div>

<div class="story-4 story_keyword_cont reverse">    
    <div class="txtbox">
        <p class="title serif">{{ first_item.section2_banner2_title }}</p>
        <p class="desc serif">{{ first_item.section2_banner2_dsec }}</p>            
    </div>
    <div class="right imgbox">
        <div class="bgbox"><div class="bg"><img src="{{ first_item.section2_banner2_img | image_url: width: 800 }}" alt="{{ first_item.section2_banner2_title }}"></div></div>
    </div>        
</div>

<div class="story-4 story_keyword_cont">    
    <div class="left imgbox">
        <div class="bgbox"><div class="bg"><img src="{{ first_item.section2_banner3_img | image_url: width: 800 }}" alt="{{ first_item.section2_banner3_title }}"></div></div>
    </div>      
    <div class="right txtbox">                
        <p class="title serif">{{ first_item.section2_banner3_title }}</p>                
        <p class="desc serif">{{ first_item.section2_banner3_dsec }}</p>
    </div>
</div>

<div class="story-4 story_keyword_cont reverse">    
    <div class="left txtbox">
        <p class="title serif">{{ first_item.section2_banner4_title }}</p>
        <p class="desc serif">{{ first_item.section2_banner4_dsec }}</p>            
    </div>
    <div class="right imgbox">
        <div class="bgbox"><div class="bg"><img src="{{ first_item.section2_banner4_img | image_url: width: 800 }}" alt="{{ first_item.section2_banner4_title }}"></div></div>
    </div>        
</div>

<div class="story-5">    
    <div class="txtbox">
        <p class="desc serif">{{ first_item.section3_dsec }}</p>            
    </div>
    <div class="imgbox">
        <div class="bgbox"><div class="bg"><img src="{{ first_item.section3_img | image_url: width: 1200 }}" alt="Final Story"></div></div>
    </div>        
</div>

{% else %}
    <p>등록된 메타오브젝트 데이터가 없습니다.</p>
{% endif %}